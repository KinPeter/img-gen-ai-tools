{
  "CheckpointLoader_Base": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "<base-model-checkpoint-name>.safetensors"
    }
  },
  "EmptyLatentImage": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "batch_size": 1,
      "height": 1216,
      "width": 832
    }
  },
  "PositiveCLIP_Base": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["CheckpointLoader_Base", 1],
      "text": "hyper-realistic, photorealistic"
    }
  },
  "NegativeCLIP_Base": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["CheckpointLoader_Base", 1],
      "text": "extra limbs, deformed fingers, bad anatomy"
    }
  },
  "Sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["CheckpointLoader_Base", 0],
      "seed": 695823221,
      "steps": 12,
      "cfg": 1,
      "sampler_name": "lcm",
      "scheduler": "kl_optimal",
      "positive": ["PositiveCLIP_Base", 0],
      "negative": ["NegativeCLIP_Base", 0],
      "latent_image": ["EmptyLatentImage", 0],
      "denoise": 1
    }
  },
  "VAEDecode_1": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["Sampler", 0],
      "vae": ["CheckpointLoader_Base", 2]
    }
  },
  "SaveImage": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["VAEDecode_1", 0],
      "filename_prefix": "my-new-image"
    }
  }
}
