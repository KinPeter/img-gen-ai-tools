[
  {
    "workflow": {
      "CheckpointLoader_Base": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
          "ckpt_name": "<base-model-checkpoint-name>.safetensors"
        }
      },
      "ClipSkip_Base": {
        "class_type": "CLIPSetLastLayer",
        "inputs": {
          "clip": ["CheckpointLoader_Base", 1],
          "stop_at_clip_layer": -2
        }
      },
      "PositiveCLIP_Base": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "clip": ["ClipSkip_Base", 0],
          "text": "masterpiece, best quality, clip skip created"
        }
      },
      "NegativeCLIP_Base": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "clip": ["ClipSkip_Base", 0],
          "text": "low quality, bad anatomy"
        }
      },
      "Sampler": {
        "class_type": "KSampler",
        "inputs": {
          "model": ["CheckpointLoader_Base", 0],
          "seed": 1000000001,
          "steps": 10,
          "cfg": 7,
          "sampler_name": "euler",
          "scheduler": "normal",
          "positive": ["PositiveCLIP_Base", 0],
          "negative": ["NegativeCLIP_Base", 0],
          "latent_image": ["EmptyLatentImage", 0],
          "denoise": 1
        }
      },
      "EmptyLatentImage": {
        "class_type": "EmptyLatentImage",
        "inputs": {
          "batch_size": 1,
          "height": 512,
          "width": 512
        }
      },
      "SaveImage": {
        "class_type": "SaveImage",
        "inputs": {
          "images": ["Sampler", 0],
          "filename_prefix": "output"
        }
      }
    },
    "input": {
      "base-workflow": "minimal-no-clipskip",
      "clip-skip": -2,
      "prompt": ["clip skip created"]
    }
  }
]
