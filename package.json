{
  "name": "img-gen-ai-tools",
  "version": "1.0.0",
  "description": "Image generation AI tools, CLI with scripts to invoke comfy-ui inference and manage RunPod Cloud GPUs",
  "license": "ISC",
  "author": "Peter Kin",
  "type": "module",
  "main": "batch.mjs",
  "scripts": {
    "batch": "node batch.mjs",
    "convert-all": "node jobs/convert.mjs",
    "find-log-from-files": "node jobs/find-log-from-files.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start-pod": "node runpod/start-pod.mjs",
    "stop-pod": "node runpod/stop-pod.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "vitest": "^5.0.4"
  }
}
