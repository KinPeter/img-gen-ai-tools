[
  {
    "workflow": {
      "CheckpointLoader_Base": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
          "ckpt_name": "<base-model-checkpoint-name>.safetensors"
        }
      },
      "Lora_1": {
        "class_type": "LoraLoader",
        "inputs": {
          "model": ["CheckpointLoader_Base", 0],
          "clip": ["CheckpointLoader_Base", 1],
          "lora_name": "first-lora.safetensors",
          "strength_model": 1,
          "strength_clip": 1
        }
      },
      "Lora_2": {
        "class_type": "LoraLoader",
        "inputs": {
          "model": ["Lora_1", 0],
          "clip": ["Lora_1", 1],
          "lora_name": "second-lora.safetensors",
          "strength_model": 0.5,
          "strength_clip": 0.5
        }
      },
      "Lora_3": {
        "class_type": "LoraLoader",
        "inputs": {
          "model": ["Lora_2", 0],
          "clip": ["Lora_2", 1],
          "lora_name": "third-lora.safetensors",
          "strength_model": 0.3,
          "strength_clip": 0.3
        }
      },
      "EmptyLatentImage": {
        "class_type": "EmptyLatentImage",
        "inputs": {
          "batch_size": 1,
          "height": 1216,
          "width": 832
        }
      },
      "ClipSkip_Base": {
        "class_type": "CLIPSetLastLayer",
        "inputs": {
          "clip": ["Lora_3", 1],
          "stop_at_clip_layer": -2
        }
      },
      "PositiveCLIP_Base": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "clip": ["ClipSkip_Base", 0],
          "text": "masterpiece, best quality, highres, three loras chained"
        }
      },
      "NegativeCLIP_Base": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "clip": ["ClipSkip_Base", 0],
          "text": "lowres, bad anatomy, extra limbs"
        }
      },
      "Sampler": {
        "class_type": "KSampler",
        "inputs": {
          "model": ["Lora_3", 0],
          "seed": 1000000001,
          "steps": 20,
          "cfg": 8,
          "sampler_name": "euler",
          "scheduler": "normal",
          "positive": ["PositiveCLIP_Base", 0],
          "negative": ["NegativeCLIP_Base", 0],
          "latent_image": ["EmptyLatentImage", 0],
          "denoise": 1
        }
      },
      "SaveImage": {
        "class_type": "SaveImage",
        "inputs": {
          "images": ["Sampler", 0],
          "filename_prefix": "output"
        }
      }
    },
    "input": {
      "base-workflow": "full-base",
      "loras": [
        {
          "name": "first-lora.safetensors",
          "strength": 1
        },
        {
          "name": "second-lora.safetensors",
          "strength": 0.5
        },
        {
          "name": "third-lora.safetensors",
          "strength": 0.3
        }
      ],
      "prompt": ["three loras chained"]
    }
  }
]
