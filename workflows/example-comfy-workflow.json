{
  "CheckpointLoader_Base": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "<base-model-checkpoint-name>.safetensors"
    }
  },
  "Lora_1": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["CheckpointLoader_Base", 0],
      "clip": ["CheckpointLoader_Base", 1],
      "lora_name": "<first-lora-name>.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0
    }
  },
  "Lora_2": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["Lora_1", 0],
      "clip": ["Lora_1", 1],
      "lora_name": "<second-lora-name>.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0
    }
  },
  "Lora_3": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["Lora_2", 0],
      "clip": ["Lora_2", 1],
      "lora_name": "<third-lora-name>.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0
    }
  },
  "EmptyLatentImage": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "batch_size": 1,
      "height": 1216,
      "width": 832
    }
  },
  "ClipSkip_Base": {
    "class_type": "CLIPSetLastLayer",
    "inputs": {
      "clip": ["Lora_3", 1],
      "stop_at_clip_layer": -2
    }
  },
  "PositiveCLIP_Base": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["ClipSkip_Base", 0],
      "text": "hyper-realistic, photorealistic"
    }
  },
  "NegativeCLIP_Base": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["ClipSkip_Base", 0],
      "text": "extra limbs, deformed fingers, bad anatomy, mutated body, (deformed:1.5), (bad hand:1.3), mutated, extra finger, cloned face, bad eyes"
    }
  },
  "Sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["Lora_3", 0],
      "seed": 695823221,
      "steps": 12,
      "cfg": 1,
      "sampler_name": "lcm",
      "scheduler": "kl_optimal",
      "positive": ["PositiveCLIP_Base", 0],
      "negative": ["NegativeCLIP_Base", 0],
      "latent_image": ["EmptyLatentImage", 0],
      "denoise": 1
    }
  },
  "VAEDecode_1": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["Sampler", 0],
      "vae": ["CheckpointLoader_Base", 2]
    }
  },
  "SaveImage": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["VAEDecode_1", 0],
      "filename_prefix": "my-new-image"
    }
  }
}
